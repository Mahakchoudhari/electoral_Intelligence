HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
# PostgreSQL connection string for the dashboard schema.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/electoral_intelligence
# Keep per-worker asyncpg connections within the Supabase session-pooler limit.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=3
# Comma-separated frontend origins allowed to call the API.
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Relative paths resolve from the repository root.
GIS_STATES_FILE=INDIA/INDIA_STATES.geojson
